# Copy to .env.local for local dev. On Vercel, add these in Project → Settings → Environment Variables.

# --- Brief generator (required) ---
SERPAPI_KEY=                 # free plan at serpapi.com (250 searches/month)

# At least one LLM key. The first one set writes briefs, or force one with BRIEF_LLM.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
BRIEF_LLM=                   # optional: anthropic | openai | gemini

# --- AI search tracker engines (each one is optional) ---
# ChatGPT uses OPENAI_API_KEY, Claude uses ANTHROPIC_API_KEY, Gemini uses GEMINI_API_KEY.
PERPLEXITY_API_KEY=

# Model overrides (defaults shown; change if a provider retires a model)
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-5.4-mini
GEMINI_MODEL=gemini-3.8-flash
PERPLEXITY_MODEL=sonar
PERPLEXITY_URL=https://api.perplexity.ai/v1/sonar

# --- Weekly cron (Mondays 03:00 UTC = 08:30 IST) ---
CRON_SECRET=                 # any long random string
TRACK_BRAND=
TRACK_COMPETITORS=           # comma separated
TRACK_PROMPTS=               # separate prompts with |
TRACK_ENGINES=               # optional: chatgpt,perplexity,gemini,claude (default: all with keys)

# --- Google Sheets logging (optional) ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=          # paste the key with \n for newlines
SHEET_TAB_BRIEFS=Briefs
SHEET_TAB_TRACKER=Tracker

# --- Protect your quota (recommended once deployed) ---
APP_PASSWORD=
