# Copy to .env.local for local dev. On Vercel, add these in Project → Settings → Environment Variables.

# --- Brief generator (required) ---
SERPAPI_KEY=                 # free plan at serpapi.com (250 searches/month)

# LLM that writes briefs. Groq is used first when its key is set (free tier, no card).
GROQ_API_KEY=                # console.groq.com → API Keys
GROQ_MODEL=openai/gpt-oss-120b   # Llama left Groq's free tier on 2026-08-16
GROQ_REASONING_EFFORT=low    # low | medium | high (low = fastest)

# Other LLMs (optional). Force one for briefs with BRIEF_LLM.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
BRIEF_LLM=                   # optional: groq | anthropic | openai | gemini

# --- Full article writer ---
OPENROUTER_API_KEY=          # openrouter.ai → Keys (free models need no credit)
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
ARTICLE_DAILY_LIMIT=2        # free articles per visitor per day
ARTICLE_LENGTH_FACTOR=1.6    # the model overshoots length by about this much; target is divided by it
ARTICLE_SOURCE_WORDS=30000   # total words of source text sent to the writer

# --- AI search tracker engines (each one is optional) ---
# ChatGPT uses OPENAI_API_KEY, Claude uses ANTHROPIC_API_KEY, Gemini uses GEMINI_API_KEY.
PERPLEXITY_API_KEY=

# Model overrides (defaults shown; change if a provider retires a model)
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-5.4-mini
GEMINI_MODEL=gemini-3.8-flash
PERPLEXITY_MODEL=sonar
PERPLEXITY_URL=https://api.perplexity.ai/v1/sonar

# --- Weekly cron (Mondays 03:00 UTC = 08:30 IST) ---
CRON_SECRET=                 # any long random string
TRACK_BRAND=
TRACK_COMPETITORS=           # comma separated
TRACK_PROMPTS=               # separate prompts with |
TRACK_ENGINES=               # optional: chatgpt,perplexity,gemini,claude (default: all with keys)

# --- Google Sheets logging (optional) ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=          # paste the key with \n for newlines
SHEET_TAB_BRIEFS=Briefs
SHEET_TAB_TRACKER=Tracker

# --- Admin and public access ---
APP_PASSWORD=                # admin sign-in password at /admin (required for the admin area)
PUBLIC_DAILY_LIMIT=5         # free briefs per visitor per day on the public page
SESSION_SECRET=              # optional: extra secret for signing cookies
